<template>
  <style>
    #root { position: absolute; inset: 0; }
    #p2-stage { position: absolute; inset: 0; overflow: hidden; }
    #p2-zoom { position: absolute; left: 0; top: 0; width: 1080px; transform-origin: 0 0; }
    #p2-zoom svg { display: block; width: 1080px; height: {{MAP_HEIGHT}}px; }
    #p2-legend { top: 1300px; }
    #p2-legend .sq {
      display: inline-block; width: 22px; height: 22px; margin-right: 14px;
      background: var(--cabai); vertical-align: -2px;
    }
    #p2-name { top: 1370px; }
  </style>
  <div id="root" data-composition-id="peta" data-width="1080" data-height="1920">
    <div id="p2-stage">
      <div id="p2-zoom" data-layout-allow-overflow>
{{MAP_SVG}}
      </div>
    </div>
    <div class="label" id="p2-legend" data-layout-allow-safe-zone><i class="sq"></i>{{PROVINCE}}</div>
    <h2 class="hero sm" id="p2-name" data-layout-allow-safe-zone>{{DISH}}</h2>
  </div>
  <script>
    window.__timelines = window.__timelines || {};
    const tl = gsap.timeline({ paused: true });
    /* zoom 1.2 s power2.inOut, lalu satu ping (bukan loop) */
    tl.set("#p2-zoom", { x: 0, y: 460, scale: 1 }, 0);
    tl.to("#p2-zoom", { x: {{ZOOM_X}}, y: {{ZOOM_Y}}, scale: {{ZOOM_SCALE}}, duration: 1.2, ease: "power2.inOut" }, 0.1);
    tl.set("#p2-ping", { scale: 0.4, opacity: 0, transformOrigin: "50% 50%" }, 0);
    tl.fromTo("#p2-ping", { scale: 0.4, opacity: 0.9 },
      { scale: 3.0, opacity: 0, duration: 0.9, ease: "power2.out", immediateRender: false }, 1.25);
    tl.fromTo("#p2-legend", { y: 10 }, { y: 0, duration: 0.3, ease: "power2.out" }, 1.3);
    tl.fromTo("#p2-name", { y: 20 }, { y: 0, duration: 0.45, ease: "power3.out" }, 1.45);
    window.__timelines["peta"] = tl;
    tl.seek(0);
  </script>
